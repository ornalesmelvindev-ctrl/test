#!/usr/bin/env bash

set -euo pipefail

# ---------------------------------------------------------
# Argument Validation
# ---------------------------------------------------------
if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
	echo "Usage: $0 <recipe_name> <target_device_ip> [deploy|builddeploy]"
	echo ""
	echo "Examples:"
	echo "  $0 pmc-poll-manager 192.168.0.120 deploy"
	echo "  $0 pmc-poll-manager 192.168.0.120 builddeploy"
	exit 1
fi

RECIPE="$1"
DEVICE_IP="$2"
MODE="${3:-builddeploy}"

case "$MODE" in
deploy | builddeploy) ;;
*)
	echo "[-] Invalid mode: $MODE"
	echo "Allowed modes: deploy, builddeploy"
	exit 1
	;;
esac

# ---------------------------------------------------------
# Target Device Credentials
# ---------------------------------------------------------
DEVICE_USER="root"
DEVICE_PASS="gEd2Be&v"

# ---------------------------------------------------------
# Jump Host Credentials
# ---------------------------------------------------------
GATEWAY_USER="melvin"
GATEWAY_IP="$(awk -F= '/^melvin=/{print $2}' /etc/users_ip)"
GATEWAY_PASS="clear12"

# ---------------------------------------------------------
# Build Paths
# ---------------------------------------------------------
BASE_PATH="/home/melvin/dev/project/ewd-orv3-pmc/artesyn-shelf/build/tmp/work/armv7ahf-vfpv4d16-poky-linux-gnueabi"

# ---------------------------------------------------------
# SSH Options
# ---------------------------------------------------------
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5"

# ---------------------------------------------------------
# Connectivity Detection
# ---------------------------------------------------------
DIRECT_MODE=false

echo "[+] Pre-check: Testing direct connectivity to Target Device (${DEVICE_IP})..."

if ping -c 1 -W 2 "${DEVICE_IP}" >/dev/null 2>&1; then

	echo "[+] Target Device is directly reachable."
	DIRECT_MODE=true

	echo "[+] Verifying SSH access to Target Device..."

	if ! sshpass -p "$DEVICE_PASS" \
		ssh $SSH_OPTS "${DEVICE_USER}@${DEVICE_IP}" true >/dev/null 2>&1; then
		echo "[-] Error: Device is pingable but SSH access failed."
		exit 1
	fi

else

	echo "[*] Target Device is not directly reachable. Falling back to Jump Host."

	echo "[+] Pre-check: Testing network connectivity to Jump Host (${GATEWAY_IP})..."

	if ! sshpass -p "$GATEWAY_PASS" \
		ssh $SSH_OPTS "${GATEWAY_USER}@${GATEWAY_IP}" true >/dev/null 2>&1; then
		echo "[-] Error: Cannot connect to Jump Host (${GATEWAY_IP})."
		exit 1
	fi
fi

if [ "$DIRECT_MODE" = false ]; then

	echo "[+] Pre-check: Testing Jump Host to Target Device (${DEVICE_IP}) connectivity..."

	if ! sshpass -p "$GATEWAY_PASS" \
		ssh $SSH_OPTS "${GATEWAY_USER}@${GATEWAY_IP}" \
		"sshpass -p '$DEVICE_PASS' ssh $SSH_OPTS ${DEVICE_USER}@${DEVICE_IP} true" \
		>/dev/null 2>&1; then

		echo "[-] Error: Jump Host authentication to Target Device failed."
		exit 1
	fi
fi

# ---------------------------------------------------------
# Build Stage
# ---------------------------------------------------------
if [[ "$MODE" == "builddeploy" ]]; then

	echo "=== Cleaning $RECIPE ==="

	if ! bitbake -c clean "$RECIPE"; then
		echo "[-] Error: Bitbake clean failed."
		exit 1
	fi

	echo "=== Building $RECIPE ==="

	if ! bitbake "$RECIPE"; then
		echo "[-] Error: Bitbake build failed."
		exit 1
	fi

	echo ""
	# read -rp "Do you want to deploy the build files to the device? (y/n): " CONFIRM
	#
	# if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
	# 	echo "[*] Deployment cancelled by user."
	# 	exit 0
	# fi
fi

# ---------------------------------------------------------
# Deploy Stage
# ---------------------------------------------------------
if [[ "$MODE" == "deploy" || "$MODE" == "builddeploy" ]]; then

	echo "=== Locating deployment source directory ==="

	if [ ! -d "$BASE_PATH/$RECIPE" ]; then
		echo "[-] Error: Recipe directory not found at $BASE_PATH/$RECIPE."
		exit 1
	fi

	IMAGE_DIR=$(find "$BASE_PATH/$RECIPE" -type d -path "*/image" | head -n 1)

	if [ -z "$IMAGE_DIR" ]; then
		echo "[*] image/ directory not found. Falling back to sysroot-destdir..."
		IMAGE_DIR=$(find "$BASE_PATH/$RECIPE" -type d -path "*/sysroot-destdir" | head -n 1)
	fi

	if [ -z "$IMAGE_DIR" ] || [ ! -d "$IMAGE_DIR" ]; then
		echo "[-] Error: Could not find either 'image/' or 'sysroot-destdir/' for '$RECIPE'."
		exit 1
	fi

	echo "[+] Using deployment source: $IMAGE_DIR"

	BINARY_PATH=$(
		find \
			"$IMAGE_DIR/usr/bin" \
			"$IMAGE_DIR/usr/sbin" \
			"$IMAGE_DIR/usr/libexec" \
			-type f 2>/dev/null | head -n 1 || true
	)

	if [ -n "$BINARY_PATH" ]; then
		BINARY_NAME=$(basename "$BINARY_PATH")
	else
		BINARY_NAME="$RECIPE"
	fi

	echo "[+] Service/Binary Name: $BINARY_NAME"

	TAR_BALL="/tmp/${RECIPE}_deploy.tar.gz"

	echo "[+] Archiving image folder to $TAR_BALL..."

	tar -czf "$TAR_BALL" -C "$IMAGE_DIR" .

	echo "=== Managing deployment to Target Device ($DEVICE_IP) ==="

	echo "[+] Stopping service: $BINARY_NAME"

	if [ "$DIRECT_MODE" = true ]; then

		sshpass -p "$DEVICE_PASS" \
			ssh $SSH_OPTS "${DEVICE_USER}@${DEVICE_IP}" \
			"systemctl stop ${BINARY_NAME} || true"

	else

		sshpass -p "$GATEWAY_PASS" \
			ssh $SSH_OPTS "${GATEWAY_USER}@${GATEWAY_IP}" \
			"sshpass -p '$DEVICE_PASS' ssh $SSH_OPTS ${DEVICE_USER}@${DEVICE_IP} 'systemctl stop ${BINARY_NAME} || true'"
	fi

	if [ "$DIRECT_MODE" = true ]; then

		echo "[+] Deploying archive directly to Target Device..."

		if ! sshpass -p "$DEVICE_PASS" \
			scp $SSH_OPTS \
			"$TAR_BALL" \
			"${DEVICE_USER}@${DEVICE_IP}:/tmp/"; then

			echo "[-] Error: Direct SCP deployment failed."
			rm -f "$TAR_BALL"
			exit 1
		fi

		echo "[+] Extracting image contents..."

		sshpass -p "$DEVICE_PASS" \
			ssh $SSH_OPTS "${DEVICE_USER}@${DEVICE_IP}" "
                tar -xzf /tmp/$(basename "$TAR_BALL") -C /
                rm -f /tmp/$(basename "$TAR_BALL")
                systemctl daemon-reload || true
                ldconfig || true
            "

	else

		echo "[+] Copying archive to Jump Host..."

		if ! sshpass -p "$GATEWAY_PASS" \
			scp $SSH_OPTS \
			"$TAR_BALL" \
			"${GATEWAY_USER}@${GATEWAY_IP}:/tmp/"; then

			echo "[-] Error: Failed to copy archive to Jump Host."
			rm -f "$TAR_BALL"
			exit 1
		fi

		echo "[+] Copying archive from Jump Host to Target Device..."

		if ! sshpass -p "$GATEWAY_PASS" \
			ssh $SSH_OPTS "${GATEWAY_USER}@${GATEWAY_IP}" "
                set -e

                sshpass -p '$DEVICE_PASS' \
                scp $SSH_OPTS \
                /tmp/$(basename "$TAR_BALL") \
                ${DEVICE_USER}@${DEVICE_IP}:/tmp/

                sshpass -p '$DEVICE_PASS' \
                ssh $SSH_OPTS ${DEVICE_USER}@${DEVICE_IP} '
                    tar -xzf /tmp/$(basename "$TAR_BALL") -C /
                    rm -f /tmp/$(basename "$TAR_BALL")
                    systemctl daemon-reload || true
                    ldconfig || true
                '

                rm -f /tmp/$(basename "$TAR_BALL")
            "; then

			echo "[-] Error: Target deployment copy/extraction failed."
			rm -f "$TAR_BALL"
			exit 1
		fi
	fi

	rm -f "$TAR_BALL"

	echo "[+] Restarting service: $BINARY_NAME"

	if [ "$DIRECT_MODE" = true ]; then

		sshpass -p "$DEVICE_PASS" \
			ssh $SSH_OPTS "${DEVICE_USER}@${DEVICE_IP}" "
                systemctl daemon-reload || true
                systemctl restart ${BINARY_NAME}
                systemctl status ${BINARY_NAME} --no-pager -l || true
            "

	else

		sshpass -p "$GATEWAY_PASS" \
			ssh $SSH_OPTS "${GATEWAY_USER}@${GATEWAY_IP}" "
                sshpass -p '$DEVICE_PASS' \
                ssh $SSH_OPTS ${DEVICE_USER}@${DEVICE_IP} '
                    systemctl daemon-reload || true
                    systemctl restart ${BINARY_NAME}
                    systemctl status ${BINARY_NAME} --no-pager -l || true
                '
            "
	fi

	echo ""
	echo "======================================="
	echo "      DEPLOYMENT SUCCESSFUL"
	echo "======================================="
fi
