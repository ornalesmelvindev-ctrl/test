static void setup_capabilities_and_algorithms(void *spdm_context)
{
    libspdm_data_parameter_t parameter;
    memset(&parameter, 0, sizeof(parameter));
    parameter.location = LIBSPDM_DATA_LOCATION_LOCAL;

    uint8_t ct_exponent = 12; /* CT = 2^12 microseconds cap on responder think-time */
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_CT_EXPONENT,
                      &parameter, &ct_exponent, sizeof(ct_exponent));

    /* NOTE: MEAS_CAP is a *responder*-only capability flag (only the
     * responder produces measurements, so only it advertises support
     * for them) -- there is no requester-side MEAS_CAP flag, which is
     * why it's not listed here even though the requester is the one
     * that will go on to call libspdm_get_measurement(). We only
     * claim CERT_CAP -- deliberately not doing KEY_EX/session/
     * encryption capabilities, since this demo only exercises the
     * unsecured connection + measurement flow. */
    uint32_t cap_flags =
        SPDM_GET_CAPABILITIES_REQUEST_FLAGS_CERT_CAP;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_FLAGS,
                      &parameter, &cap_flags, sizeof(cap_flags));

    uint8_t meas_spec = SPDM_MEASUREMENT_SPECIFICATION_DMTF;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_MEASUREMENT_SPEC,
                      &parameter, &meas_spec, sizeof(meas_spec));

    uint32_t asym_algo = SPDM_ALGORITHMS_BASE_ASYM_ALGO_TPM_ALG_ECDSA_ECC_NIST_P256;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_BASE_ASYM_ALGO,
                      &parameter, &asym_algo, sizeof(asym_algo));

