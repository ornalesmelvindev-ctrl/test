    libspdm_set_data(spdm_context, LIBSPDM_DATA_BASE_HASH_ALGO,
                      &parameter, &hash_algo, sizeof(hash_algo));

    uint32_t measurement_hash_algo = SPDM_ALGORITHMS_MEASUREMENT_HASH_ALGO_TPM_ALG_SHA_256;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_MEASUREMENT_HASH_ALGO,
                      &parameter, &measurement_hash_algo, sizeof(measurement_hash_algo));

    uint32_t data_transfer_size = MODBUS_MAX_SPDM_MESSAGE_SIZE;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_DATA_TRANSFER_SIZE,
                    &parameter, &data_transfer_size, sizeof(data_transfer_size));

    uint32_t max_spdm_msg_size = MODBUS_MAX_SPDM_MESSAGE_SIZE;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_MAX_SPDM_MSG_SIZE,
                    &parameter, &max_spdm_msg_size, sizeof(max_spdm_msg_size));

    VLOG(ROLE, "advertised: ct_exp=%u cap_flags=0x%08X asym=ECDSA_P256 hash=SHA256",
         ct_exponent, cap_flags);
}

