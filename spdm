bb file
SUMMARY = "DMTF libspdm - SPDM (Security Protocol and Data Model) reference implementation"
DESCRIPTION = "Requester/Responder library implementing DSP0274 SPDM, DSP0277 secured \
messages and DSP0275 SPDM-over-MCTP. Built here as static libs + headers for use by \
spdm-startup-app."
HOMEPAGE = "https://github.com/DMTF/libspdm"
LICENSE = "BSD-3-Clause"
LIC_FILES_CHKSUM = "file://LICENSE.md;md5=REPLACE_ME_AFTER_FIRST_FETCH"

# gitsm:// (not git://) so bitbake pulls the mbedtls/cmocka submodules too.
# Pin SRCREV to a real commit before this goes anywhere near production;
# AUTOREV is only here so you can do a first successful fetch+build.
SRC_URI = "gitsm://github.com/DMTF/libspdm.git;protocol=https;branch=main"
SRCREV = "${AUTOREV}"
PV = "3.6.0+git${SRCPV}"

S = "${WORKDIR}/git"
B = "${WORKDIR}/build"

DEPENDS = "openssl"

# Deliberately NOT inheriting cmake.bbclass: libspdm's own CMakeLists selects a
# toolchain file per -DTOOLCHAIN=<name> that hardcodes upstream GNU cross-compiler
# binary names (e.g. arm-none-linux-gnueabihf-gcc / aarch64-none-linux-gnu-gcc).
# Those don't exist in a Yocto sysroot (ours are *-poky-linux-*). Rather than patch
# libspdm's CMakeLists (fragile across upstream bumps), we drop wrapper scripts with
# the exact names libspdm expects onto PATH, each just exec'ing our real cross tools.

def libspdm_arch(d):
    ta = d.getVar('TARGET_ARCH')
    if ta == 'aarch64':
        return ('aarch64', 'aarch64-none-linux-gnu')
    elif ta.startswith('arm'):
        return ('arm', 'arm-none-linux-gnueabihf')
    else:
        bb.fatal('libspdm recipe: unmapped TARGET_ARCH "%s" - add it to libspdm_arch()' % ta)

do_configure() {
    rm -rf ${WORKDIR}/toolchain-wrappers
    mkdir -p ${WORKDIR}/toolchain-wrappers

    # ${LIBSPDM_TOOLCHAIN_PREFIX} is computed below in do_configure:prepend via
    # inline python, exported as LIBSPDM_WRAP_PREFIX.
    for pair in "gcc:${CC}" "g++:${CXX}" "ar:${AR}" "ranlib:${RANLIB}" \
                "ld:${LD}" "as:${AS}" "objcopy:${OBJCOPY}" "objdump:${OBJDUMP}" "strip:${STRIP}"; do
        tool="${pair%%:*}"
        real="${pair#*:}"
        wrapper="${WORKDIR}/toolchain-wrappers/${LIBSPDM_WRAP_PREFIX}-${tool}"
        cat > "${wrapper}" <<EOF
#!/bin/sh
exec ${real} "\$@"
EOF
        chmod +x "${wrapper}"
    done

    rm -rf ${B}
    mkdir -p ${B}
    cd ${B}
    PATH="${WORKDIR}/toolchain-wrappers:${PATH}" \
        cmake -G"Unix Makefiles" \
            -DARCH=${LIBSPDM_ARCH} \
            -DTOOLCHAIN=ARM_GNU \
            -DTARGET=Release \
            -DCRYPTO=mbedtls \
            ${S}
}

python () {
    arch, prefix = libspdm_arch(d)
    d.setVar('LIBSPDM_ARCH', arch)
    d.setVar('LIBSPDM_WRAP_PREFIX', prefix)
}

do_configure[dirs] += "${B}"

do_compile() {
    cd ${B}
    PATH="${WORKDIR}/toolchain-wrappers:${PATH}" oe_runmake copy_sample_key
    PATH="${WORKDIR}/toolchain-wrappers:${PATH}" oe_runmake -j "${@oe.utils.parallel_make(d)}"
}

do_install() {
    install -d ${D}${includedir}/libspdm
    cp -r ${S}/include/* ${D}${includedir}/libspdm/

    install -d ${D}${libdir}
    find ${B}/lib -name '*.a' -exec install -m 0644 {} ${D}${libdir}/ \;
}

FILES_${PN} = "${libdir}/*.a"
FILES_${PN}-dev = "${includedir}/libspdm"

# Static libs only right now - nothing to put in a runtime/staticdev split debate yet.
INSANE_SKIP_${PN} += "staticdev"

BBCLASSEXTEND = ""

 take note to use '_' instead of ':' in like FILES_${PN}

