'use strict';

/**
 * Shared shell helpers.
 *
 * - WSL availability is detected ONCE (cached) instead of re-checking on
 *   every single action. If WSL is available, WSL-flavored commands are
 *   used; otherwise everything falls back to plain PowerShell.
 * - exec() calls always get a timeout + maxBuffer so a stuck/unreachable
 *   SSH host can't hang forever and pile up zombie processes.
 */

const { execSync, exec } = require('child_process');

let wslAvailableCache = null;

/**
 * Checks (once, then caches) whether WSL is installed and usable.
 * Call `resetWSLCache()` if you ever need to force a re-check.
 */
function detectWSL() {
  return false;
  if (wslAvailableCache !== null) return wslAvailableCache;

  try {
    execSync('wsl.exe --status', { stdio: 'ignore', timeout: 5000 });
    wslAvailableCache = true;
  } catch {
    wslAvailableCache = false;
  }

  return wslAvailableCache;
}

function resetWSLCache() {
  wslAvailableCache = null;
}

/**
 * Runs a shell command with sane defaults: a timeout so it can't hang
 * forever, and a generous maxBuffer so normal command output doesn't
 * trigger ERR_CHILD_PROCESS_STDIO_MAXBUFFER.
 */
function runCommand(cmd, options = {}) {
  const execOptions = {
    timeout: options.timeout ?? 20000,
    maxBuffer: options.maxBuffer ?? 10 * 1024 * 1024,
    windowsHide: options.windowsHide ?? false
  };

  return new Promise((resolve, reject) => {
    exec(cmd, execOptions, (err, stdout, stderr) => {
      if (err) {
        const timedOut = err.killed && err.signal === 'SIGTERM';
        reject(new Error(timedOut ? 'Command timed out' : (stderr?.trim() || err.message)));
        return;
      }
      resolve({ stdout, stderr });
    });
  });
}

/**
 * Fire-and-forget version for launching a detached interactive window
 * (e.g. "open an SSH session in a new terminal"). We don't wait on it.
 */
function launchDetached(cmd) {
  exec(cmd, { windowsHide: false }, (err, stdout, stderr) => {
    if (stdout) console.log(stdout);
    if (stderr) console.log(stderr);
    if (err) console.error('[launchDetached]', err.message);
  });
}

module.exports = { detectWSL, resetWSLCache, runCommand, launchDetached };

style.css
:root{
  --bg-solid:#10151a;
  --panel:#1a2129;
  --panel-2:#1f2830;
  --border:#2a333c;
  --border-soft:#232b33;
  --text:#e7ebee;
  --text-dim:#8c98a3;
  --text-faint:#5c6873;
  --amber:#e8a548;
  --amber-dim:#8a6a3a;
  --cyan:#5fb8c9;
  --green:#5fbf82;
  --blue:#4a9deb;
  --radius:3px;
  --mono:'IBM Plex Mono', ui-monospace, monospace;
  --sans:'IBM Plex Sans', system-ui, sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(circle at 1px 1px, #ffffff08 1px, transparent 1px) 0 0/28px 28px,
    var(--bg-solid);
  color:var(--text);
  font-family:var(--sans);
  min-height:100vh;
  padding-bottom:60px;
}
a,button{color:inherit;text-decoration:none;}
button{font-family:inherit; background:none; border:none; cursor:pointer;}

/* ---------- topbar ---------- */
.topbar{
  border-bottom:1px solid var(--border);
  background:linear-gradient(180deg,#141a20,#10151a);
  padding:22px 36px 20px;
  position:sticky; top:0; z-index:20;
  backdrop-filter:blur(6px);
}
.topbar-inner{
  max-width:1180px; margin:0 auto;
  display:flex; align-items:flex-end; justify-content:space-between;
  gap:24px; flex-wrap:wrap;
}
.brand{display:flex; align-items:center; gap:12px;}
.brand-mark{
  width:34px;height:34px;
  border:1px solid var(--amber-dim);
  border-radius:4px;
  display:grid; place-items:center;
  font-family:var(--mono); font-size:11px; color:var(--amber);
  background:#1c1710; flex-shrink:0;
}
.brand h1{font-size:19px; font-weight:600; margin:0; letter-spacing:0.2px;}
.brand p{margin:2px 0 0; font-size:12.5px; color:var(--text-dim); font-family:var(--mono);}
.top-right{display:flex; align-items:center; gap:18px;}
#clock{font-family:var(--mono); font-size:13px; color:var(--text-dim); text-align:right; line-height:1.4;}
#clock .date{color:var(--text-faint); font-size:11.5px;}
.search-wrap{position:relative;}
#search{
  background:var(--panel); border:1px solid var(--border); color:var(--text);
  font-family:var(--sans); font-size:13.5px; padding:9px 12px 9px 32px;
  border-radius:var(--radius); width:220px; outline:none;
  transition:border-color .15s ease;
}
#search:focus{border-color:var(--amber-dim);}
#search::placeholder{color:var(--text-faint);}
.search-wrap svg{position:absolute; left:10px; top:50%; transform:translateY(-50%); width:14px;height:14px; stroke:var(--text-faint); pointer-events:none;}

/* ---------- layout ---------- */
main{max-width:1180px; margin:0 auto; padding:38px 36px 0;}
section{margin-bottom:44px;}
.section-head{display:flex; align-items:baseline; gap:10px; margin-bottom:16px; padding-bottom:10px; border-bottom:1px solid var(--border-soft);}
.section-head h2{font-size:14px; font-weight:600; margin:0; letter-spacing:0.3px;}
.section-head .count{font-family:var(--mono); font-size:11.5px; color:var(--text-faint);}
.section-head .rule{flex:1; height:1px; background:var(--border-soft);}

.group-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(258px,1fr));
  gap:14px;
  align-items:start;
}

.group-card{
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:var(--radius);
  overflow:hidden;
  transition:border-color .15s ease;
}
.group-card:hover{border-color:#3a4550;}
.group-title{
  font-family:var(--mono);
  font-size:13.5px;
  font-weight:600;
  letter-spacing:0.4px;
  color:var(--amber);
  padding:11px 14px;
  border-bottom:1px solid var(--border-soft);
  background:var(--panel-2);
  display:flex; align-items:center; gap:8px;
}
.group-title .status-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--green);
  box-shadow:0 0 6px #5fbf8299;
  flex-shrink:0;
}
.item-row{
  display:flex; align-items:center; justify-content:space-between;
  padding:7px 8px 7px 14px;
  font-size:13px;
  border-bottom:1px solid var(--border-soft);
  position:relative;
}
.item-row:last-child{border-bottom:none;}
.item-row:hover{background:var(--panel-2);}
.item-name{
  color:var(--text); font-weight:500;
  flex:1; padding:5px 0;
}
.item-actions{display:flex; align-items:center; gap:2px; flex-shrink:0;}
.mini-btn{
  width:26px; height:26px;
  display:grid; place-items:center;
  border-radius:2px;
  color:var(--text-faint);
  border:1px solid transparent;
}
.mini-btn:hover{color:var(--cyan); border-color:var(--border);}
.mini-btn.wsl:hover{color:var(--blue);}
.mini-btn svg{width:13px;height:13px;}

#links-section .group-title{color:var(--cyan);}

.empty{color:var(--text-faint); font-family:var(--mono); font-size:12.5px; padding:20px 4px;}

/* toast for confirmation messages */
#toast{
  position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(12px);
  background:var(--panel-2); border:1px solid var(--border);
  color:var(--text); font-family:var(--mono); font-size:12.5px;
  padding:10px 16px; border-radius:var(--radius);
  box-shadow:0 8px 24px #0009;
  opacity:0; pointer-events:none;
  transition:opacity .18s ease, transform .18s ease;
  z-index:50;
  display:flex; align-items:center; gap:8px;
}
#toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
#toast svg{width:14px;height:14px; stroke:var(--green); flex-shrink:0;}

footer{
  max-width:1180px; margin:20px auto 0; padding:16px 36px 0;
  color:var(--text-faint); font-family:var(--mono); font-size:11px; line-height:1.6;
  border-top:1px solid var(--border-soft);
}

@media (max-width:640px){
  .topbar{padding:18px 18px;}
  main{padding:28px 18px 0;}
  footer{padding:16px 18px 0;}
  #search{width:150px;}
  .top-right{gap:10px;}
}

.pmc-table{
  width:100%;
  border-collapse:collapse;
  background:var(--panel);
  border:1px solid var(--border);
}
.pmc-table th,
.pmc-table td{
  padding:10px;
  border-bottom:1px solid var(--border-soft);
  text-align:left;
  font-size:13px;
}
.pmc-table th{
  background:var(--panel-2);
  font-family:var(--mono);
}
.pmc-action{
  padding:5px 10px;
  border:1px solid var(--border);
  background:var(--panel-2);
  cursor:pointer;
  color:var(--text);
  margin-right:4px;
}
.pmc-action:hover{
  border-color:var(--cyan);
}
.pmc-action:disabled{
  opacity:0.35;
  cursor:not-allowed;
}
.pmc-action:disabled:hover{
  border-color:var(--border);
}
.pmc-free{color:var(--green);}
.pmc-busy{color:#ff6b6b;}
