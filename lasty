'use strict';

/* ============================================================
   Rendering helpers
   ============================================================ */

function parseData(raw) {
  return raw
    .split(/\n\s*\n/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => {
      const lines = block.split('\n').map((l) => l.trim()).filter(Boolean);
      const title = lines[0];
      const items = lines.slice(1).map((line) => {
        const idx = line.indexOf('|');
        if (idx === -1) return null;
        return { name: line.slice(0, idx).trim(), url: line.slice(idx + 1).trim() };
      }).filter(Boolean);
      return { title, items };
    })
    .filter((g) => g.items.length > 0);
}

function icons() {
  return {
    external: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>',
    wsl: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3"/><path d="M12 15h5"/></svg>'
  };
}

function renderGroups(groups, gridEl, countEl, withWsl) {
  const total = groups.reduce((n, g) => n + g.items.length, 0);
  countEl.textContent = total;

  if (!groups.length) {
    gridEl.innerHTML = '<div class="empty">No matches.</div>';
    return;
  }

  const ic = icons();
  gridEl.innerHTML = groups.map((g) => `
    <div class="group-card">
      <div class="group-title"><span class="status-dot"></span>${g.title}</div>
      ${g.items.map((it) => `
        <div class="item-row">
          <a class="item-name" href="${it.url}" target="_blank" rel="noopener">${it.name}</a>
          <div class="item-actions">
            <a class="mini-btn" href="${it.url}" target="_blank" rel="noopener" title="Open repo">${ic.external}</a>
            ${withWsl ? `<button class="mini-btn wsl" type="button" data-repo-url="${encodeURIComponent(it.url)}" title="Open in VS Code">${ic.wsl}</button>` : ''}
          </div>
        </div>
      `).join('')}
    </div>
  `).join('');
}

let repoGroups = [];
let linkGroups = [];

async function loadConfiguration() {
  try {
    const config = await window.electronAPI.getConfig();
    repoGroups = parseData(config.repos || '');
    linkGroups = parseData(config.links || '');
    applyFilter('');
  } catch (err) {
    console.error('Failed to load configuration:', err);
    showToast('Failed to load config.js — see console');
  }
}

function applyFilter(q) {
  q = q.trim().toLowerCase();
  const filterGroups = (groups) => !q ? groups : groups
    .map((g) => ({
      title: g.title,
      items: g.items.filter((it) => it.name.toLowerCase().includes(q) || g.title.toLowerCase().includes(q))
    }))
    .filter((g) => g.items.length > 0);

  renderGroups(filterGroups(repoGroups), document.getElementById('repo-grid'), document.getElementById('repo-count'), true);
  renderGroups(filterGroups(linkGroups), document.getElementById('links-grid'), document.getElementById('links-count'), false);
}

document.getElementById('search').addEventListener('input', (e) => applyFilter(e.target.value));

/* ============================================================
   Toast
   ============================================================ */

function showToast(text) {
  const toast = document.getElementById('toast');
  document.getElementById('toast-text').textContent = text;
  toast.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => toast.classList.remove('show'), 2200);
}

/* ============================================================
   Clock
   ============================================================ */

function tickClock() {
  const now = new Date();
  const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const date = now.toLocaleDateString([], { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
  document.getElementById('clock').innerHTML = `${time}<div class="date">${date}</div>`;
}
tickClock();
setInterval(tickClock, 1000);

/* ============================================================
   PMC monitor
   ============================================================ */

let pmcRefreshTimer = null;
let pmcScanRunning = false;

function renderPmcs(devices) {
  document.getElementById('pmc-count').textContent = devices.length;

  const statusBadge = (ok) => ok
    ? '<span class="pmc-free">\u{1F7E2} Yes</span>'
    : '<span class="pmc-busy">\u{1F534} No</span>';

  const html = `
    <table class="pmc-table">
      <thead>
        <tr><th>IP</th><th>Variant</th><th>SSH</th><th>Redfish</th><th>User</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
        ${devices.map((device) => `
          <tr>
            <td>${device.ip}</td>
            <td>${device.variant}</td>
            <td>${statusBadge(device.sshAvailable)}</td>
            <td>${statusBadge(device.redfishAvailable)}</td>
            <td>${device.users}</td>
            <td>${device.occupied ? '<span class="pmc-busy">\u{1F534} In Use</span>' : '<span class="pmc-free">\u{1F7E2} Available</span>'}</td>
            <td>
              <button class="pmc-action" data-ssh-ip="${device.ip}" ${device.sshAvailable ? '' : 'disabled title="SSH not available on this device"'}>SSH</button>
              <button class="pmc-action" data-webui-ip="${device.ip}" ${device.redfishAvailable ? '' : 'disabled title="Redfish/WebUI not available on this device"'}>WebUI</button>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;

  document.getElementById('pmc-grid').innerHTML = html;
}

async function scanPmcs() {
  if (pmcScanRunning) return;
  pmcScanRunning = true;

  try {
    const devices = await window.electronAPI.scanPmcs();
    renderPmcs(devices);
    document.getElementById('pmc-last-scan').textContent = `Last Scan: ${new Date().toLocaleTimeString()}`;
  } catch (err) {
    console.error('PMC scan failed:', err);
    showToast('PMC scan failed');
  } finally {
    pmcScanRunning = false;
  }
}

document.getElementById('scan-pmc-btn').addEventListener('click', scanPmcs);

document.getElementById('pmc-refresh').addEventListener('change', (e) => {
  clearInterval(pmcRefreshTimer);
  const seconds = Number(e.target.value);
  if (seconds > 0) {
    pmcRefreshTimer = setInterval(scanPmcs, seconds * 1000);
  }
});

/* ============================================================
   Click delegation: repo open / SSH / WebUI
   ============================================================ */

document.addEventListener('click', async (e) => {
  const sshBtn = e.target.closest('[data-ssh-ip]');
  if (sshBtn) {
    const ip = sshBtn.dataset.sshIp;
    try {
      await window.electronAPI.sshPmc(ip);
      showToast(`Connecting to ${ip}...`);
    } catch (err) {
      console.error(err);
      showToast('Failed to launch SSH session');
    }
    return;
  }

  const webuiBtn = e.target.closest('[data-webui-ip]');
  if (webuiBtn) {
    const ip = webuiBtn.dataset.webuiIp;
    try {
      await window.electronAPI.openWebUI(ip);
      showToast(`Opening WebUI for ${ip}`);
    } catch (err) {
      console.error(err);
      showToast('Failed to open WebUI');
    }
    return;
  }

  const repoBtn = e.target.closest('[data-repo-url]');
  if (!repoBtn) return;

  const url = decodeURIComponent(repoBtn.dataset.repoUrl);
  try {
    await window.electronAPI.openRepo(url);
    showToast('Opening in VS Code...');
  } catch (err) {
    console.error(err);
    showToast('Failed to launch repository');
  }
});

/* ============================================================
   Global error safety net — surface failures instead of the
   page silently going dead.
   ============================================================ */

window.addEventListener('error', (e) => {
  console.error('Renderer error:', e.error || e.message);
});
window.addEventListener('unhandledrejection', (e) => {
  console.error('Unhandled rejection:', e.reason);
});

/* ============================================================
   Boot
   ============================================================ */

loadConfiguration();
scanPmcs();
document.getElementById('pmc-refresh').dispatchEvent(new Event('change'));

