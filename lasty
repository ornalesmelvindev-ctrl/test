'use strict';

const { app, BrowserWindow, ipcMain, shell, dialog } = require('electron');
const path = require('path');
const fs = require('fs');
const os = require('os');
const { detectWSL, runCommand, launchDetached } = require('./shellRunner');

// Log instead of letting the process die silently.
process.on('uncaughtException', (err) => {
  console.error('UNCAUGHT EXCEPTION:', err);
});
process.on('unhandledRejection', (err) => {
  console.error('UNHANDLED REJECTION:', err);
});

// Prevent two copies of the dashboard from running at once.
if (!app.requestSingleInstanceLock()) {
  app.quit();
}

let mainWindow = null;

function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1500,
    height: 900,
    webPreferences: {
      preload: path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false
    }
  });

  mainWindow.loadFile('index.html');

  // Open all external links in the default browser instead of a new Electron window.
  mainWindow.webContents.setWindowOpenHandler(({ url }) => {
    shell.openExternal(url);
    return { action: 'deny' };
  });

  mainWindow.webContents.on('will-navigate', (event, url) => {
    if (url !== mainWindow.webContents.getURL()) {
      event.preventDefault();
      shell.openExternal(url);
    }
  });
}

/**
 * Resolves config.js and binary paths correctly whether running from source
 * (`npm start`) or from a packaged build.
 */
function getAppDir() {
  return app.isPackaged
    ? path.dirname(app.getPath('exe')) // extraFiles land next to the exe
    : app.getAppPath();                // project root during development
}

function getConfigPath() {
  return path.join(getAppDir(), 'config.js');
}

/**
 * Resolves the absolute path to the bundled Windows sshpass binary.
 * Wraps pathing in quotes to safely handle spaces in Windows user accounts.
 */
function getSshpassPath() {
  const binaryPath = path.join(getAppDir(), 'bin', 'sshpass.exe');
  return `"${binaryPath}"`;
}

function loadConfig() {
  const configPath = getConfigPath();

  if (!fs.existsSync(configPath)) {
    throw new Error(
      `config.js not found at:\n${configPath}\n\n` +
      'Copy config.example.js to config.js and fill in your details.'
    );
  }

  delete require.cache[require.resolve(configPath)];
  const config = require(configPath);

  return {
    repoBasePath: config.repoBasePath || ['Documents', 'repositories'],
    repos: config.repos || '',
    links: config.links || '',
    ssh: {
      scan: config.ssh?.scan || null,
      connect: config.ssh?.connect || null
    }
  };
}

function getRepoBaseDir() {
  const config = loadConfig();
  return path.join(os.homedir(), ...config.repoBasePath);
}

/** Wraps a single-quoted shell literal safely (escapes embedded quotes). */
function q(value) {
  return `'${String(value).replace(/'/g, `'\\''`)}'`;
}

app.whenReady().then(() => {
  const usingWSL = detectWSL();
  console.log(`[startup] WSL available: ${usingWSL}`);
  createWindow();
});

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') app.quit();
});

app.on('second-instance', () => {
  if (mainWindow) {
    if (mainWindow.isMinimized()) mainWindow.restore();
    mainWindow.focus();
  }
});

// ---------------------------------------------------------------------
// IPC handlers
// ---------------------------------------------------------------------

ipcMain.handle('get-config', () => {
  try {
    return loadConfig();
  } catch (err) {
    console.error('[get-config]', err.message);
    dialog.showErrorBox('Configuration error', err.message);
    return { repoBasePath: [], repos: '', links: '', ssh: { scan: null, connect: null } };
  }
});

ipcMain.handle('open-repo', async (_event, repoUrl) => {
  const repoPath = repoUrl.replace('https://bitbucket.org', '').replace(/\/$/, '');
  const repoName = repoPath.split('/').pop();
  const cloneUrl = `git@bitbucket.org:${repoPath}.git`;
  const baseDir = getRepoBaseDir();

  const useWSL = detectWSL();
  let cmd;

  if (useWSL) {
    const wslBase = baseDir.replace(/\\/g, '/').replace(/^([A-Za-z]):/, (_m, drive) => `/mnt/${drive.toLowerCase()}`);
    cmd = `wsl.exe -e bash -lc "mkdir -p ${q(wslBase)} && cd ${q(wslBase)} && ([ -d ${q(repoName)} ] || git clone ${q(cloneUrl)} ${q(repoName)}) && code ${q(repoName)}"`;
  } else {
    cmd = `powershell.exe -NoProfile -Command "& { if (!(Test-Path '${baseDir}')) { New-Item -ItemType Directory -Force -Path '${baseDir}' | Out-Null }; Set-Location '${baseDir}'; if (!(Test-Path '${repoName}')) { git clone '${cloneUrl}' '${repoName}' }; code '${repoName}' }"`;
  }

  console.log('[open-repo]', cmd);
  launchDetached(cmd);
  return true;
});

ipcMain.handle('scan-pmcs', async () => {
  const config = loadConfig();
  const scanCfg = config.ssh.scan;

  if (!scanCfg) {
    throw new Error('No ssh.scan settings found in config.js');
  }

  const sshOpts = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10';
  const useWSL = detectWSL();
  
  let cmd;
  if (useWSL) {
    const inner = `sshpass -p ${q(scanCfg.password)} ssh ${sshOpts} ${scanCfg.user}@${scanCfg.host} -- ${q(scanCfg.remoteCommand)}`;
    cmd = `wsl.exe -e bash -lc "${inner.replace(/"/g, '\\"')}"`;
  } else {
    const exePath = getSshpassPath();
    cmd = `powershell.exe -NoProfile -Command "& { & ${exePath} -p ${q(scanCfg.password)} ssh ${sshOpts} ${scanCfg.user}@${scanCfg.host} -- ${q(scanCfg.remoteCommand)} }"`;
  }

  console.log('[scan-pmcs] start', new Date().toISOString());

  try {
    const { stdout } = await runCommand(cmd, { timeout: 20000 });

    const rowPattern = /^\|\s*([\d.]+)\s*\|\s*(.*?)\s*\|\s*(Yes|No)\s*\|\s*(Yes|No)\s*\|\s*(.*?)\s*\|$/i;
    const devices = [];
    
    stdout.split('\n').forEach((line) => {
      const match = line.match(rowPattern);
      if (!match) return;

      const users = match[5].trim();
      const noUser = ['none', 'n/a'].includes(users.toLowerCase());

      devices.push({
        ip: match[1].trim(),
        variant: match[2].trim(),
        sshAvailable: match[3].toLowerCase() === 'yes',
        redfishAvailable: match[4].toLowerCase() === 'yes',
        users,
        occupied: !noUser
      });
    });

    console.log('[scan-pmcs] done', new Date().toISOString(), `${devices.length} devices`);
    return devices;
  } catch (err) {
    console.error('[scan-pmcs] failed:', err.message);
    throw new Error(err.message);
  }
});

ipcMain.handle('open-webui', async (_event, ip) => {
  shell.openExternal(`https://${ip}`);
  return true;
});

ipcMain.handle('ssh-pmc', async (_event, ip) => {
  const config = loadConfig();
  const connectCfg = config.ssh.connect;

  if (!connectCfg) {
    throw new Error('No ssh.connect settings found in config.js');
  }

  const sshOpts = '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ServerAliveInterval=15 -o ServerAliveCountMax=3';
  const useWSL = detectWSL();
  
  let cmd;
  if (useWSL) {
    const inner = `sshpass -p ${q(connectCfg.password)} ssh ${sshOpts} ${connectCfg.user}@${ip}`;
    cmd = `start wsl.exe -e bash -lc "${inner.replace(/"/g, '\\"')}"`;
  } else {
    const exePath = getSshpassPath();
    cmd = `start powershell.exe -NoExit -Command "& { & ${exePath} -p ${q(connectCfg.password)} ssh ${sshOpts} ${connectCfg.user}@${ip} }"`;
  }

  console.log('[ssh-pmc]', cmd);
  launchDetached(cmd);
  return true;
});

