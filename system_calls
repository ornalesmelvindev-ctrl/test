{
    device_variant_et type_e                            = DEVICE_VARIANT_STANDARD;
    uint8_t u8_variant_id                               = 0x00;
    char cmd[DBUS_COMMAND_STRING_BUFFER_LENGTH]         = { 0 };
    char response[DBUS_COMMAND_STRING_BUFFER_LENGTH]    = { 0 };
    char buffer[DBUS_COMMAND_STRING_BUFFER_LENGTH]      = { 0 };

    /** PCBREV_ID_0 */
    memset(&cmd[0], 0, DBUS_COMMAND_STRING_BUFFER_LENGTH);
    (void)sprintf(&cmd[0],
                "%s",
                GET_PMC_SOM_PCBREV_0_CMD
                );

    if (0 == exec_cmd(cmd, &response[0], DBUS_COMMAND_STRING_BUFFER_LENGTH))
    {
        (void)sprintf(&buffer[0], "%s", trimTrailingCharacter(&response[0], '\n'));

        if ( 0 == strcmp( "1", buffer ))
        {
            u8_variant_id |= MASK_ID_0;
        }
        else
        {
            u8_variant_id &= ~MASK_ID_0;
        }
    }

    /** PCBREV_ID_1 */
    memset(&cmd[0], 0, DBUS_COMMAND_STRING_BUFFER_LENGTH);
    (void)sprintf(&cmd[0],
                "%s",
                GET_PMC_SOM_PCBREV_1_CMD
                );

    if (0 == exec_cmd(cmd, &response[0], DBUS_COMMAND_STRING_BUFFER_LENGTH))
    {
        (void)sprintf(&buffer[0], "%s", trimTrailingCharacter(&response[0], '\n'));

        if ( 0 == strcmp( "1", buffer ))
        {
            u8_variant_id |= MASK_ID_1;
        }
        else
        {
            u8_variant_id &= ~MASK_ID_1;
        }
    }

    /** PCBREV_ID_2 */
    memset(&cmd[0], 0, DBUS_COMMAND_STRING_BUFFER_LENGTH);
    (void)sprintf(&cmd[0],
                "%s",
                GET_PMC_SOM_PCBREV_2_CMD
                );

    if (0 == exec_cmd(cmd, &response[0], DBUS_COMMAND_STRING_BUFFER_LENGTH))
    {
        (void)sprintf(&buffer[0], "%s", trimTrailingCharacter(&response[0], '\n'));

        if ( 0 == strcmp( "1", buffer ))
        {
            u8_variant_id |= MASK_ID_2;
        }
        else
        {
            u8_variant_id &= ~MASK_ID_2;
        }
    }

    switch (u8_variant_id)
    {
        case DEVICE_VARIANT_HPR:
        {
            type_e = DEVICE_VARIANT_HPR;
            break;
        }

        case DEVICE_VARIANT_HPR_V2:
        {
            type_e = DEVICE_VARIANT_HPR_V2;
            break;
        }

        default:
        {
            type_e = DEVICE_VARIANT_STANDARD; //Default
            break;
        }
    }

    return type_e;
}

