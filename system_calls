static const char GET_PMC_SHELF_TYPE_CMD[] =
    "busctl call aei.dev.pollmanager1 /aei/dev/pollmanager1/actions aei.dev.pollmanager1.actionRequests readShelfType | awk '{print $2;}'";

static shelf_type_et get_shelf_type(void)
{
    shelf_type_et e_type = SHELF_TYPE_UNKNOWN;
    char cmd[DBUS_COMMAND_STRING_BUFFER_LENGTH] = {0};
    char response[DBUS_COMMAND_STRING_BUFFER_LENGTH] = {0};
    char buffer[DBUS_COMMAND_STRING_BUFFER_LENGTH] = {0};

    memset(&cmd[0], 0, DBUS_COMMAND_STRING_BUFFER_LENGTH);
    (void)sprintf(&cmd[0],
                  "%s",
                  GET_PMC_SHELF_TYPE_CMD);

    if (0 == exec_cmd(cmd, &response[0], DBUS_COMMAND_STRING_BUFFER_LENGTH))
    {
        (void)sprintf(&buffer[0], "%s", trimTrailingCharacter(&response[0], '\n'));

        if (0 == strcmp("\"BBU_SHELF\"", buffer))
        {
            e_type = SHELF_TYPE_BBU;
        }
        else if (0 == strcmp("\"PSU_SHELF\"", buffer))
        {
            e_type = SHELF_TYPE_PSU;
        }
    }

    return e_type;
}













