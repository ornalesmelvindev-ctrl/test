wired_conf.c
#include <stdio.h>
#include <string.h>

#include "wired_conf.h"

#define WIRED_CONF_FILE \
"/etc/systemd/network/80-wired.network.d/80-wired.conf"

static void trim_newline(char *s)
{
    s[strcspn(s, "\r\n")] = 0;
}

int wired_conf_read(
        osal_net_config_t *cfg)
{
    FILE *fp;
    char line[256];

    memset(cfg, 0, sizeof(*cfg));

    fp = fopen(WIRED_CONF_FILE, "r");
    if (!fp)
        return -1;

    while (fgets(line, sizeof(line), fp))
    {
        trim_newline(line);

        if (!strncmp(line, "DNS=", 4))
        {
            strcpy(cfg->dns, line + 4);
        }
        else if (!strncmp(line, "DHCP=", 5))
        {
            if (!strcmp(line + 5, "ipv4") ||
                !strcmp(line + 5, "yes"))
            {
                cfg->dhcp_enabled = 1;
            }
        }
        else if (!strncmp(line, "Address=", 8))
        {
            strcpy(cfg->ipv4_addr,
                   line + 8);
        }
        else if (!strncmp(line, "Gateway=", 8))
        {
            strcpy(cfg->ipv4_gateway,
                   line + 8);
        }
        else if (!strncmp(line,
                 "#Address=", 9))
        {
            if (strchr(line + 9, '.'))
            {
                strcpy(
                    cfg->ipv4_addr,
                    line + 9);
            }
            else if (strchr(line + 9, ':'))
            {
                strcpy(
                    cfg->ipv6_addr,
                    line + 9);
            }
        }
        else if (!strncmp(line,
                 "#Gateway=", 9))
        {
            if (strchr(line + 9, '.'))
            {
                strcpy(
                    cfg->ipv4_gateway,
                    line + 9);
            }
            else if (strchr(line + 9, ':'))
            {
                strcpy(
                    cfg->ipv6_gateway,
                    line + 9);
            }
        }
        else if (!strncmp(line,
                 "IPv6AcceptRA=", 13))
        {
            if (!strcmp(line + 13,
                        "yes"))
            {
                cfg->ipv6_accept_ra = 1;
            }
        }
    }

    fclose(fp);

    return 0;
}

int wired_conf_write(
        const osal_net_config_t *cfg)
{
    FILE *fp;

    fp = fopen(WIRED_CONF_FILE, "w");

    if (!fp)
        return -1;

    fprintf(fp,
        "[Match]\n"
        "Name=eth0\n\n");

    fprintf(fp,
        "[Network]\n");

    fprintf(fp,
        "DNS=%s\n",
        cfg->dns);

    fprintf(fp,
        "# Enable Both IPv4 and IPv6\n");

    fprintf(fp,
        "DHCP=%s\n\n",
        cfg->dhcp_enabled ?
        "ipv4" :
        "no");

    fprintf(fp,
        "# --- IPv4 Static ---\n");

    if (cfg->dhcp_enabled)
    {
        fprintf(fp,
            "#Address=%s\n",
            cfg->ipv4_addr);

        fprintf(fp,
            "#Gateway=%s\n",
            cfg->ipv4_gateway);
    }
    else
    {
        fprintf(fp,
            "Address=%s\n",
            cfg->ipv4_addr);

        fprintf(fp,
            "Gateway=%s\n",
            cfg->ipv4_gateway);
    }

    fprintf(fp,
        "\n# --- IPv6 Static ---\n");

    fprintf(fp,
        "#Address=%s\n",
        cfg->ipv6_addr);

    fprintf(fp,
        "#Gateway=%s\n",
        cfg->ipv6_gateway);

    fprintf(fp,
        "\n");

    fprintf(fp,
        "LinkLocalAddressing=ipv6\n");

    fprintf(fp,
        "IPv6AcceptRA=%s\n\n",
        cfg->ipv6_accept_ra ?
        "yes" :
        "no");

    fprintf(fp,
        "[DHCP]\n"
        "RouteMetric=200\n"
        "UseMTU=true\n"
        "VendorClassIdentifier="
        "Artesyn_700_015496_0000\n");

    fclose(fp);

    return system(
        "systemctl restart "
        "systemd-networkd");
}

netlink.c
#include <arpa/inet.h>
#include <ifaddrs.h>
#include <stdio.h>
#include <string.h>

#include "netlink.h"

int netlink_get_ipv4(
        const char *ifname,
        char *ip,
        size_t len,
        int *prefix)
{
    struct ifaddrs *ifaddr;
    struct ifaddrs *ifa;

    if (getifaddrs(&ifaddr))
        return -1;

    for (ifa = ifaddr;
         ifa;
         ifa = ifa->ifa_next)
    {
        if (!ifa->ifa_addr)
            continue;

        if (strcmp(
                ifa->ifa_name,
                ifname))
            continue;

        if (ifa->ifa_addr->sa_family
            == AF_INET)
        {
            struct sockaddr_in *sa =
                (struct sockaddr_in *)
                ifa->ifa_addr;

            inet_ntop(
                AF_INET,
                &sa->sin_addr,
                ip,
                len);

            *prefix = 24;

            freeifaddrs(ifaddr);
            return 0;
        }
    }

    freeifaddrs(ifaddr);

    return -1;
}

int netlink_get_gateway(
        char *gateway,
        size_t len)
{
    FILE *fp;
    char line[256];

    fp = fopen("/proc/net/route",
               "r");

    if (!fp)
        return -1;

    fgets(line,
          sizeof(line),
          fp);

    while (fgets(line,
                 sizeof(line),
                 fp))
    {
        char iface[32];
        unsigned long dest;
        unsigned long gw;

        if (sscanf(
                line,
                "%31s %lx %lx",
                iface,
                &dest,
                &gw) == 3)
        {
            if (dest == 0)
            {
                struct in_addr addr;

                addr.s_addr = gw;

                snprintf(
                    gateway,
                    len,
                    "%s",
                    inet_ntoa(addr));

                fclose(fp);

                return 0;
            }
        }
    }

    fclose(fp);

    return -1;
}

ip.c
#include <string.h>

#include "osal_network.h"
#include "wired_conf.h"
#include "netlink.h"

int osal_get_network_config(
        osal_net_config_t *cfg)
{
    return wired_conf_read(cfg);
}

int osal_set_network_config(
        const osal_net_config_t *cfg)
{
    return wired_conf_write(cfg);
}

int osal_get_dhcp_status(
        int *enabled)
{
    osal_net_config_t cfg;

    if (osal_get_network_config(
            &cfg))
        return -1;

    *enabled =
        cfg.dhcp_enabled;

    return 0;
}

int osal_get_runtime_ipv4(
        osal_runtime_ipv4_t *cfg)
{
    int prefix;
    char ip[64];

    if (netlink_get_ipv4(
            "eth0",
            ip,
            sizeof(ip),
            &prefix))
    {
        return -1;
    }

    snprintf(
        cfg->ip,
        sizeof(cfg->ip),
        "%s/%d",
        ip,
        prefix);

    netlink_get_gateway(
        cfg->gateway,
        sizeof(cfg->gateway));

    return 0;
}

