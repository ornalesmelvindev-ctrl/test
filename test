#include <stdio.h>
#include <string.h>

#include "osal_network.h"

static int get_static_ip(void)
{
    osal_net_config_t cfg;

    osal_get_network_config(&cfg);

    printf("ip: %s,\n",
           cfg.ipv4_addr);

    printf("gateway: %s,\n",
           cfg.ipv4_gateway);

    printf("status: %s\n",
           cfg.dhcp_enabled ?
           "disabled" :
           "enabled");

    return 0;
}

static int get_dynamic_ip(void)
{
    osal_runtime_ipv4_t cfg;

    osal_get_runtime_ipv4(&cfg);

    printf("ip: %s,\n",
           cfg.ip);

    printf("gateway: %s\n",
           cfg.gateway);

    return 0;
}

static int get_dhcp(void)
{
    int enabled;

    osal_get_dhcp_status(
        &enabled);

    printf(
        "status: %s\n",
        enabled ?
        "enabled" :
        "disabled");

    return 0;
}

int main(
        int argc,
        char **argv)
{
    if (argc < 2)
        return -1;

    if (!strcmp(
            argv[1],
            "--get_static_ip"))
    {
        return get_static_ip();
    }

    if (!strcmp(
            argv[1],
            "--get_dynamic_ip"))
    {
        return get_dynamic_ip();
    }

    if (!strcmp(
            argv[1],
            "--get_dhcp_status"))
    {
        return get_dhcp();
    }

    return -1;
}




