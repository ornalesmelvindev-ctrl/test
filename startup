/*
 * spdm-startup-app - PMC SPDM requester bring-up
 *
 * Goal for this milestone: prove the libspdm integration (context, transport
 * encode/decode, device IO, crypto backend) actually works on-target, by
 * running the connection-setup phase of SPDM:
 *
 *      GET_VERSION -> GET_CAPABILITIES -> NEGOTIATE_ALGORITHMS
 *
 * which libspdm exposes as a single call: libspdm_init_connection().
 *
 * TRANSPORT: this uses the MCTP message encode/decode helpers that ship in
 * libspdm (transport-mctp lib), which is the right binding long-term (DSP0275
 * SPDM-over-MCTP) since your PSUs already sit on an I2C/PMBus bus. But actually
 * moving MCTP frames over I2C requires a kernel MCTP-I2C binding driver (or a
 * userspace SMBus block-write/read shim) AND a responder on the other end -
 * neither of which exists yet on your PSU. So:
 *
 *      spdm_device_send_message() / spdm_device_receive_message()
 *
 * below are stubbed as an AF_UNIX loopback so you can pair this app with a
 * responder process (e.g. spdm-emu's responder, or a second instance of your
 * own code acting as responder) running ON THE PMC, to validate everything
 * above the wire before real hardware is in the loop.
 *
 * CHECK AGAINST YOUR FETCHED HEADERS BEFORE TRUSTING THIS BLINDLY:
 * libspdm's public API (especially the device_io / buffer-acquire callback
 * shapes) has changed across versions. Grep
 *   ${STAGING_INCDIR}/libspdm/library/spdm_requester_lib.h
 *   ${STAGING_INCDIR}/libspdm/library/spdm_common_lib.h
 * for the exact signatures your fetched SRCREV provides and adjust the
 * callback registration calls if they don't match.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

#include "library/spdm_requester_lib.h"
#include "library/spdm_transport_mctp_lib.h"
#include "library/spdm_common_lib.h"

#define LOOPBACK_SOCK_PATH "/tmp/spdm-loopback.sock"
#define SENDER_BUF_SIZE    0x1200
#define RECEIVER_BUF_SIZE  0x1200

/* Max size (bytes) of an SPDM message body this transport will hand to/from
 * libspdm - not a library-provided constant, just our own transport's limit.
 * Keep it >= the buffer sizes above minus MCTP header/tail overhead. */
#define SPDM_MAX_MESSAGE_SIZE 0x1200

static int g_sock = -1;

/* --- device IO: swap this file's contents for a real transport later --- */

static libspdm_return_t spdm_device_send_message(void *spdm_context,
                                                   size_t message_size,
                                                   const void *message,
                                                   uint64_t timeout)
{
    (void)spdm_context;
    (void)timeout;
    if (send(g_sock, message, message_size, 0) != (ssize_t)message_size) {
        perror("spdm_device_send_message: send");
        return LIBSPDM_STATUS_SEND_FAIL;
    }
    return LIBSPDM_STATUS_SUCCESS;
}

static libspdm_return_t spdm_device_receive_message(void *spdm_context,
                                                      size_t *message_size,
                                                      void **message,
                                                      uint64_t timeout)
{
    (void)spdm_context;
    (void)timeout;
    ssize_t n = recv(g_sock, *message, *message_size, 0);
    if (n <= 0) {
        perror("spdm_device_receive_message: recv");
        return LIBSPDM_STATUS_RECEIVE_FAIL;
    }
    *message_size = (size_t)n;
    return LIBSPDM_STATUS_SUCCESS;
}

/* MCTP transport header encode/decode - reuse libspdm's helpers so the
 * message-framing layer is already spec-correct; only the raw byte
 * send/receive above is our stand-in. */
static libspdm_return_t spdm_transport_encode(void *spdm_context,
                                               const uint32_t *session_id,
                                               bool is_app_message,
                                               bool is_requester,
                                               size_t message_size,
                                               void *message,
                                               size_t *transport_message_size,
                                               void **transport_message)
{
    return libspdm_transport_mctp_encode_message(
        spdm_context, session_id, is_app_message,
        is_requester, message_size, message,
        transport_message_size, transport_message);
}

static libspdm_return_t spdm_transport_decode(void *spdm_context,
                                               uint32_t **session_id,
                                               bool *is_app_message,
                                               bool is_requester,
                                               size_t transport_message_size,
                                               void *transport_message,
                                               size_t *message_size,
                                               void **message)
{
    return libspdm_transport_mctp_decode_message(
        spdm_context, session_id, is_app_message, is_requester,
        transport_message_size, transport_message, message_size, message);
}

static int connect_loopback(void)
{
    int sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("socket");
        return -1;
    }

    struct sockaddr_un addr = {0};
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, LOOPBACK_SOCK_PATH, sizeof(addr.sun_path) - 1);

    if (connect(sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("connect (is a responder listening on the socket yet?)");
        close(sock);
        return -1;
    }
    return sock;
}

int main(void)
{
    printf("spdm-startup-app: connecting to responder loopback...\n");
    g_sock = connect_loopback();
    if (g_sock < 0) {
        fprintf(stderr,
                "no responder at %s - start one first (see README)\n",
                LOOPBACK_SOCK_PATH);
        return 1;
    }

    size_t context_size = libspdm_get_context_size();
    void *spdm_context = malloc(context_size);
    if (!spdm_context) {
        fprintf(stderr, "OOM allocating spdm_context (%zu bytes)\n", context_size);
        return 1;
    }
    libspdm_init_context(spdm_context);

    libspdm_register_device_io_func(spdm_context,
                                     spdm_device_send_message,
                                     spdm_device_receive_message);
    libspdm_register_transport_layer_func(spdm_context,
                                           SPDM_MAX_MESSAGE_SIZE,
                                           LIBSPDM_MCTP_TRANSPORT_HEADER_SIZE,
                                           LIBSPDM_MCTP_TRANSPORT_TAIL_SIZE,
                                           spdm_transport_encode,
                                           spdm_transport_decode);

    static uint8_t sender_buf[SENDER_BUF_SIZE];
    static uint8_t receiver_buf[RECEIVER_BUF_SIZE];
    libspdm_register_device_buffer_func(
        spdm_context, SENDER_BUF_SIZE, RECEIVER_BUF_SIZE,
        NULL, NULL, NULL, NULL); /* see header comment: confirm signature */
    (void)sender_buf;
    (void)receiver_buf;

    /* Minimal requester capability set for the startup handshake - no
     * mutual auth, no PSK, no measurements yet. Widen this once GET_VERSION/
     * GET_CAPABILITIES/NEGOTIATE_ALGORITHMS is proven out. */
    libspdm_data_parameter_t parameter = {0};
    parameter.location = LIBSPDM_DATA_LOCATION_LOCAL;

    uint8_t ct_exponent = 0;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_CT_EXPONENT,
                      &parameter, &ct_exponent, sizeof(ct_exponent));

    uint32_t requester_cap_flags = 0; /* no CERT_CAP/CHAL_CAP yet - bare handshake */
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_FLAGS,
                      &parameter, &requester_cap_flags, sizeof(requester_cap_flags));

    printf("spdm-startup-app: running GET_VERSION / GET_CAPABILITIES / "
           "NEGOTIATE_ALGORITHMS...\n");

    libspdm_return_t status = libspdm_init_connection(spdm_context, false);
    if (LIBSPDM_STATUS_IS_ERROR(status)) {
        fprintf(stderr, "libspdm_init_connection failed: 0x%x\n", (unsigned)status);
        free(spdm_context);
        close(g_sock);
        return 1;
    }

    printf("SPDM connection established (version/capabilities/algorithms "
           "negotiated OK).\n");

    /* TODO next milestones, in order:
     *   1. GET_DIGESTS / GET_CERTIFICATE   (needs a cert chain + CERT_CAP)
     *   2. CHALLENGE                        (needs CHAL_CAP + private key access)
     *   3. GET_MEASUREMENTS                 (attest PSU fw/config state)
     *   4. Swap loopback for real MCTP-over-I2C transport once the PSU
     *      responder side exists.
     */

    free(spdm_context);
    close(g_sock);
    return 0;
}

