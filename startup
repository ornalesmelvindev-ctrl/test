/*
 * spdm-startup-app - PMC SPDM requester bring-up
 *
 * Goal for this milestone: prove the libspdm integration (context, transport
 * encode/decode, device IO, crypto backend) actually works on-target, by
 * running the connection-setup phase of SPDM:
 *
 *      GET_VERSION -> GET_CAPABILITIES -> NEGOTIATE_ALGORITHMS
 *
 * which libspdm exposes as a single call: libspdm_init_connection().
 *
 * TRANSPORT: this uses the MCTP message encode/decode helpers that ship in
 * libspdm (transport-mctp lib), which is the right binding long-term (DSP0275
 * SPDM-over-MCTP) since your PSUs already sit on an I2C/PMBus bus. But actually
 * moving MCTP frames over I2C requires a kernel MCTP-I2C binding driver (or a
 * userspace SMBus block-write/read shim) AND a responder on the other end -
 * neither of which exists yet on your PSU. So:
 *
 *      spdm_device_send_message() / spdm_device_receive_message()
 *
 * below are stubbed as an AF_UNIX loopback so you can pair this app with a
 * responder process (spdm-responder-app) running ON THE PMC, to validate
 * everything above the wire before real hardware is in the loop.
 *
 * CHECK AGAINST YOUR FETCHED HEADERS BEFORE TRUSTING THIS BLINDLY:
 * libspdm's public API has changed across versions. Grep
 *   ${STAGING_INCDIR}/libspdm/library/spdm_requester_lib.h
 *   ${STAGING_INCDIR}/libspdm/library/spdm_common_lib.h
 * for the exact signatures your fetched SRCREV provides.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

#include "library/spdm_requester_lib.h"
#include "library/spdm_transport_mctp_lib.h"
#include "library/spdm_common_lib.h"

#define LOOPBACK_SOCK_PATH "/tmp/spdm-loopback.sock"
#define SENDER_BUF_SIZE    0x1200
#define RECEIVER_BUF_SIZE  0x1200

/* Max size (bytes) of an SPDM message body this transport will hand to/from
 * libspdm - not a library-provided constant, just our own transport's limit.
 * Keep it >= the buffer sizes above minus MCTP header/tail overhead. */
#define SPDM_MAX_MESSAGE_SIZE 0x1200

static int g_sock = -1;

static uint8_t sender_buf[SENDER_BUF_SIZE];
static uint8_t receiver_buf[RECEIVER_BUF_SIZE];

/* Diagnostic only: print raw wire bytes so an SPDM ERROR response's exact
 * error_code (byte index 2) / error_data (byte index 3) can be read
 * directly instead of guessing at capability-field mismatches. Remove once
 * the handshake is working end-to-end. */
static void hexdump(const char *label, const void *buf, size_t len)
{
    const unsigned char *p = buf;
    printf("%s (%zu bytes):", label, len);
    for (size_t i = 0; i < len; i++) {
        if (i % 16 == 0) {
            printf("\n  ");
        }
        printf("%02x ", p[i]);
    }
    printf("\n");
}

/* libspdm buffer callbacks - required as of this fetched libspdm version;
 * passing NULL for these segfaults inside libspdm_acquire_sender_buffer /
 * libspdm_acquire_receiver_buffer, which call through these unconditionally. */

static libspdm_return_t acquire_sender_buffer(
    void *spdm_context,
    void **msg_buf_ptr)
{
    (void)spdm_context;

    printf("acquire_sender_buffer\n");
    printf("sender_buf=%p\n", sender_buf);

    *msg_buf_ptr = sender_buf;

    printf("returned ptr=%p\n", *msg_buf_ptr);

    return LIBSPDM_STATUS_SUCCESS;
}

static void release_sender_buffer(
    void *spdm_context,
    const void *msg_buf_ptr)
{
    (void)spdm_context;
    (void)msg_buf_ptr;
}

static libspdm_return_t acquire_receiver_buffer(
    void *spdm_context,
    void **msg_buf_ptr)
{
    (void)spdm_context;

    printf("acquire_receiver_buffer\n");
    printf("receiver_buf=%p\n", receiver_buf);

    *msg_buf_ptr = receiver_buf;

    printf("returned ptr=%p\n", *msg_buf_ptr);

    return LIBSPDM_STATUS_SUCCESS;
}

static void release_receiver_buffer(
    void *spdm_context,
    const void *msg_buf_ptr)
{
    (void)spdm_context;
    (void)msg_buf_ptr;
}

/* --- device IO: swap this file's contents for a real transport later --- */

static libspdm_return_t spdm_device_send_message(void *spdm_context,
                                                   size_t message_size,
                                                   const void *message,
                                                   uint64_t timeout)
{
    printf("SEND size=%zu\n", message_size);
    hexdump("SEND", message, message_size);

    const uint8_t *msg = message;

    if (message_size >= 3 && msg[1] == 0x14 && msg[2] == 0xE1) {
        printf("\n*** SENT GET_CAPABILITIES ***\n");

        if (message_size >= 21) {

            uint32_t dts =
                msg[13] |
                (msg[14] << 8) |
                (msg[15] << 16) |
                (msg[16] << 24);

            uint32_t maxmsg =
                msg[17] |
                (msg[18] << 8) |
                (msg[19] << 16) |
                (msg[20] << 24);

            printf("Decoded DataTransferSize = %u (0x%x)\n",
                dts, dts);

            printf("Decoded MaxSPDMMsgSize  = %u (0x%x)\n",
                maxmsg, maxmsg);
        }
        uint32_t flags =
            msg[9]  |
            (msg[10] << 8) |
            (msg[11] << 16) |
            (msg[12] << 24);

        printf("Decoded Flags            = 0x%08x\n",
            flags);

        printf("*****************************\n");
    }

    (void)spdm_context;
    (void)timeout;
    if (send(g_sock, message, message_size, 0) != (ssize_t)message_size) {
        perror("spdm_device_send_message: send");
        return LIBSPDM_STATUS_SEND_FAIL;
    }
    return LIBSPDM_STATUS_SUCCESS;
}

static libspdm_return_t spdm_device_receive_message(void *spdm_context,
                                                      size_t *message_size,
                                                      void **message,
                                                      uint64_t timeout)
{
    (void)spdm_context;
    (void)timeout;
    ssize_t n = recv(g_sock, *message, *message_size, 0);
    if (n <= 0) {
        perror("spdm_device_receive_message: recv");
        return LIBSPDM_STATUS_RECEIVE_FAIL;
    }
    *message_size = (size_t)n;
    hexdump("RECV", *message, *message_size);

    const uint8_t *msg = *message;

    if ((*message_size >= 5) && (msg[2] == 0x7f)) {

        printf("\n*** RECEIVED SPDM ERROR ***\n");

        printf("error_code = 0x%02x\n", msg[3]);
        printf("error_data = 0x%02x\n", msg[4]);

        switch (msg[3]) {

        case 0x01:
            printf("ERROR_INVALID_REQUEST\n");
            break;

        case 0x03:
            printf("ERROR_UNSUPPORTED_REQUEST\n");
            break;

        case 0x41:
            printf("ERROR_BUSY\n");
            break;

        default:
            printf("Unknown error\n");
            break;
        }

        printf("***************************\n");
    }

    return LIBSPDM_STATUS_SUCCESS;
}

/* MCTP transport header encode/decode - reuse libspdm's helpers so the
 * message-framing layer is already spec-correct; only the raw byte
 * send/receive above is our stand-in. */
static libspdm_return_t spdm_transport_encode(void *spdm_context,
                                               const uint32_t *session_id,
                                               bool is_app_message,
                                               bool is_requester,
                                               size_t message_size,
                                               void *message,
                                               size_t *transport_message_size,
                                               void **transport_message)
{
    return libspdm_transport_mctp_encode_message(
        spdm_context, session_id, is_app_message,
        is_requester, message_size, message,
        transport_message_size, transport_message);
}

static libspdm_return_t spdm_transport_decode(void *spdm_context,
                                               uint32_t **session_id,
                                               bool *is_app_message,
                                               bool is_requester,
                                               size_t transport_message_size,
                                               void *transport_message,
                                               size_t *message_size,
                                               void **message)
{
    return libspdm_transport_mctp_decode_message(
        spdm_context, session_id, is_app_message, is_requester,
        transport_message_size, transport_message, message_size, message);
}

static int connect_loopback(void)
{
    int sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("socket");
        return -1;
    }

    struct sockaddr_un addr = {0};
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, LOOPBACK_SOCK_PATH, sizeof(addr.sun_path) - 1);

    if (connect(sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("connect (is a responder listening on the socket yet?)");
        close(sock);
        return -1;
    }
    return sock;
}

int main(void)
{
    printf("spdm-startup-app: connecting to responder loopback...\n");
    g_sock = connect_loopback();
    if (g_sock < 0) {
        fprintf(stderr,
                "no responder at %s - start one first (see README)\n",
                LOOPBACK_SOCK_PATH);
        return 1;
    }

    size_t context_size = libspdm_get_context_size();
    void *spdm_context = malloc(context_size);
    if (!spdm_context) {
        fprintf(stderr, "OOM allocating spdm_context (%zu bytes)\n", context_size);
        return 1;
    }
    libspdm_init_context(spdm_context);
    printf("spdm_context=%p\n", spdm_context);
    printf("MCTP transport header_size=%d tail_size=%d (skip this many "
           "leading bytes in RECV/SEND dumps to find the SPDM payload)\n",
           (int)LIBSPDM_MCTP_TRANSPORT_HEADER_SIZE,
           (int)LIBSPDM_MCTP_TRANSPORT_TAIL_SIZE);

    libspdm_register_device_io_func(spdm_context,
                                     spdm_device_send_message,
                                     spdm_device_receive_message);
    libspdm_register_transport_layer_func(spdm_context,
                                           SPDM_MAX_MESSAGE_SIZE,
                                           LIBSPDM_MCTP_TRANSPORT_HEADER_SIZE,
                                           LIBSPDM_MCTP_TRANSPORT_TAIL_SIZE,
                                           spdm_transport_encode,
                                           spdm_transport_decode);

    size_t scratch_size =
        libspdm_get_sizeof_required_scratch_buffer(spdm_context);

    printf("required scratch_size=%zu\n", scratch_size);

    void *scratch_buffer = malloc(scratch_size);
    if (scratch_buffer == NULL) {
        fprintf(stderr, "failed to allocate scratch buffer (%zu bytes)\n",
                scratch_size);
        return 1;
    }

    printf("allocated scratch_buffer=%p\n", scratch_buffer);

    libspdm_set_scratch_buffer(
        spdm_context,
        scratch_buffer,
        scratch_size);

    printf("scratch registered\n");

    libspdm_register_device_buffer_func(
        spdm_context,
        SENDER_BUF_SIZE,
        RECEIVER_BUF_SIZE,
        acquire_sender_buffer,
        release_sender_buffer,
        acquire_receiver_buffer,
        release_receiver_buffer);

    /* Minimal requester capability set for the startup handshake - no
     * mutual auth, no PSK, no measurements yet. Widen this once GET_VERSION/
     * GET_CAPABILITIES/NEGOTIATE_ALGORITHMS is proven out. */
    libspdm_data_parameter_t parameter = {0};
    parameter.location = LIBSPDM_DATA_LOCATION_LOCAL;

    uint8_t ct_exponent = 0;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_CT_EXPONENT,
                      &parameter, &ct_exponent, sizeof(ct_exponent));

    uint32_t data_transfer_size = SENDER_BUF_SIZE;
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_DATA_TRANSFER_SIZE,
                    &parameter, &data_transfer_size, sizeof(data_transfer_size));

    uint32_t max_spdm_msg_size = SENDER_BUF_SIZE
                                  - LIBSPDM_MCTP_TRANSPORT_HEADER_SIZE
                                  - LIBSPDM_MCTP_TRANSPORT_TAIL_SIZE;
    /* Must equal libspdm's auto-derived DataTransferSize (buffer_size -
     * header - tail), or GET_CAPABILITIES is spec-invalid without also
     * declaring CHUNK_CAP. Confirmed via hexdump: without this, we sent
     * MaxSPDMMsgSize=0x1200 (4608) while DataTransferSize came out to
     * 0x11c4 (4548) - responder correctly rejected it with ERROR/
     * InvalidRequest (0x01). */
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_MAX_SPDM_MSG_SIZE,
                    &parameter, &max_spdm_msg_size, sizeof(max_spdm_msg_size));

    printf("\n=== LOCAL CAPABILITY VALUES BEFORE INIT_CONNECTION ===\n");

    printf("Configured data_transfer_size = %u\n",
        data_transfer_size);

    printf("Configured max_spdm_msg_size = %u\n",
        max_spdm_msg_size);

    uint32_t verify_value;
    size_t verify_size;

    verify_size = sizeof(verify_value);

    libspdm_get_data(
        spdm_context,
        LIBSPDM_DATA_CAPABILITY_DATA_TRANSFER_SIZE,
        &parameter,
        &verify_value,
        &verify_size);

    printf("libspdm stored DATA_TRANSFER_SIZE = %u\n",
        verify_value);

    verify_size = sizeof(verify_value);

    libspdm_get_data(
        spdm_context,
        LIBSPDM_DATA_CAPABILITY_MAX_SPDM_MSG_SIZE,
        &parameter,
        &verify_value,
        &verify_size);

    printf("libspdm stored MAX_SPDM_MSG_SIZE = %u\n",
        verify_value);

    printf("===============================================\n");
                    
    uint32_t requester_cap_flags =
        SPDM_GET_CAPABILITIES_REQUEST_FLAGS_CHUNK_CAP;
    printf("Requester capability flags=0x%08x\n",
        requester_cap_flags);
    libspdm_set_data(spdm_context, LIBSPDM_DATA_CAPABILITY_FLAGS,
                      &parameter, &requester_cap_flags, sizeof(requester_cap_flags));

    printf("spdm-startup-app: running GET_VERSION / GET_CAPABILITIES / "
           "NEGOTIATE_ALGORITHMS...\n");

    printf("\n=== FINAL VALUES BEFORE INIT_CONNECTION ===\n");

    verify_size = sizeof(verify_value);

    libspdm_get_data(
        spdm_context,
        LIBSPDM_DATA_CAPABILITY_DATA_TRANSFER_SIZE,
        &parameter,
        &verify_value,
        &verify_size);

    printf("DTS=%u\n", verify_value);

    verify_size = sizeof(verify_value);

    libspdm_get_data(
        spdm_context,
        LIBSPDM_DATA_CAPABILITY_MAX_SPDM_MSG_SIZE,
        &parameter,
        &verify_value,
        &verify_size);

    printf("MAX=%u\n", verify_value);

    printf("==========================================\n");

    printf("calling libspdm_init_connection\n");
    libspdm_return_t status = libspdm_init_connection(spdm_context, false);
    if (LIBSPDM_STATUS_IS_ERROR(status)) {
        fprintf(stderr, "libspdm_init_connection failed: 0x%x\n", (unsigned)status);
        free(spdm_context);
        close(g_sock);
        return 1;
    }
    printf("returned from libspdm_init_connection status=0x%x\n",
       (unsigned)status);

    printf("SPDM connection established (version/capabilities/algorithms "
           "negotiated OK).\n");

    /* TODO next milestones, in order:
     *   1. GET_DIGESTS / GET_CERTIFICATE   (needs a cert chain + CERT_CAP)
     *   2. CHALLENGE                        (needs CHAL_CAP + private key access)
     *   3. GET_MEASUREMENTS                 (attest PSU fw/config state)
     *   4. Swap loopback for real MCTP-over-I2C transport once the PSU
     *      responder side exists.
     */

    free(spdm_context);
    close(g_sock);
    return 0;
}

responder main.c
/*
 * spdm-responder-app - loopback SPDM responder, paired with spdm-startup-app
 *
 * Run this FIRST (it listens), then run spdm-startup-app in another shell/
 * session on the same device. This exists purely to prove the requester
 * side actually completes a handshake against *something* - there is no
 * real PSU responder yet. Once a real device speaks SPDM, this whole file
 * is disposable; it's scaffolding, not a product.
 *
 * Mirrors spdm-startup-app/files/main.c closely on purpose: same transport
 * wrapper functions and same buffer-callback pattern work unmodified on
 * this side, since libspdm fills in is_requester per-message internally
 * based on message direction, not based on which local role we are.
 *
 * CHECK AGAINST YOUR FETCHED HEADERS BEFORE TRUSTING THIS BLINDLY:
 *   ${STAGING_INCDIR}/libspdm/library/spdm_responder_lib.h
 *   ${STAGING_INCDIR}/libspdm/library/spdm_common_lib.h
 *
 * IMPORTANT: capability data (CT_EXPONENT, DATA_TRANSFER_SIZE,
 * MAX_SPDM_MSG_SIZE, FLAGS) must be set identically in spirit on both
 * sides. Missing DATA_TRANSFER_SIZE/MAX_SPDM_MSG_SIZE here specifically
 * caused the requester to receive an SPDM ERROR PDU
 * (LIBSPDM_STATUS_ERROR_PEER, 0x8001000a) in response to GET_CAPABILITIES
 * once the requester side had those fields set and this side didn't.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

#include "library/spdm_responder_lib.h"
#include "library/spdm_transport_mctp_lib.h"
#include "library/spdm_common_lib.h"

#define LOOPBACK_SOCK_PATH "/tmp/spdm-loopback.sock"
#define SENDER_BUF_SIZE    0x1200
#define RECEIVER_BUF_SIZE  0x1200
#define SPDM_MAX_MESSAGE_SIZE 0x1200

static int g_sock = -1;

static uint8_t sender_buf[SENDER_BUF_SIZE];
static uint8_t receiver_buf[RECEIVER_BUF_SIZE];

/* Diagnostic only: print raw wire bytes so an SPDM ERROR response's exact
 * error_code (byte index 2) / error_data (byte index 3) can be read
 * directly instead of guessing at capability-field mismatches. Remove once
 * the handshake is working end-to-end. */
static void hexdump(const char *label, const void *buf, size_t len)
{
    const unsigned char *p = buf;
    printf("%s (%zu bytes):", label, len);
    for (size_t i = 0; i < len; i++) {
        if (i % 16 == 0) {
            printf("\n  ");
        }
        printf("%02x ", p[i]);
    }
    printf("\n");
}

/* libspdm buffer callbacks - same pattern as the requester side. */

static libspdm_return_t acquire_sender_buffer(
    void *spdm_context,
    void **msg_buf_ptr)
{
    (void)spdm_context;

    *msg_buf_ptr = sender_buf;
    return LIBSPDM_STATUS_SUCCESS;
}

static void release_sender_buffer(
    void *spdm_context,
    const void *msg_buf_ptr)
{
    (void)spdm_context;
    (void)msg_buf_ptr;
}

static libspdm_return_t acquire_receiver_buffer(
    void *spdm_context,
    void **msg_buf_ptr)
{
    (void)spdm_context;

    printf("acquire_receiver_buffer\n");
    printf("receiver_buf=%p\n", receiver_buf);

    *msg_buf_ptr = receiver_buf;

    printf("returned ptr=%p\n", *msg_buf_ptr);

    return LIBSPDM_STATUS_SUCCESS;
}

static void release_receiver_buffer(
    void *spdm_context,
    const void *msg_buf_ptr)
{
    (void)spdm_context;
    (void)msg_buf_ptr;
}

/* --- device IO: identical pattern to the requester side --- */

static libspdm_return_t spdm_device_send_message(void *spdm_context,
                                                   size_t message_size,
                                                   const void *message,
                                                   uint64_t timeout)
{
    (void)spdm_context;
    (void)timeout;
    hexdump("SEND", message, message_size);
    if (send(g_sock, message, message_size, 0) != (ssize_t)message_size) {
        perror("spdm_device_send_message: send");
        return LIBSPDM_STATUS_SEND_FAIL;
    }
    return LIBSPDM_STATUS_SUCCESS;
}

static libspdm_return_t spdm_device_receive_message(void *spdm_context,
                                                      size_t *message_size,
                                                      void **message,
                                                      uint64_t timeout)
{
    (void)spdm_context;
    (void)timeout;
    ssize_t n = recv(g_sock, *message, *message_size, 0);
    if (n <= 0) {
        /* 0 = peer closed cleanly; <0 = real error. Caller treats both as
         * "stop the dispatch loop", but only perror() on the real error. */
        if (n < 0) {
            perror("spdm_device_receive_message: recv");
        }
        return LIBSPDM_STATUS_RECEIVE_FAIL;
    }
    *message_size = (size_t)n;
    hexdump("RECV", *message, *message_size);
    return LIBSPDM_STATUS_SUCCESS;
}

/* Same MCTP transport wrappers as the requester - libspdm supplies
 * is_requester per call based on message direction, so this code doesn't
 * need to know or care which side it's running on. */
static libspdm_return_t spdm_transport_encode(void *spdm_context,
                                               const uint32_t *session_id,
                                               bool is_app_message,
                                               bool is_requester,
                                               size_t message_size,
                                               void *message,
                                               size_t *transport_message_size,
                                               void **transport_message)
{
    return libspdm_transport_mctp_encode_message(
        spdm_context, session_id, is_app_message,
        is_requester, message_size, message,
        transport_message_size, transport_message);
}

static libspdm_return_t spdm_transport_decode(void *spdm_context,
                                               uint32_t **session_id,
                                               bool *is_app_message,
                                               bool is_requester,
                                               size_t transport_message_size,
                                               void *transport_message,
                                               size_t *message_size,
                                               void **message)
{
    return libspdm_transport_mctp_decode_message(
        spdm_context, session_id, is_app_message, is_requester,
        transport_message_size, transport_message, message_size, message);
}

/* --- listen + accept one connection, instead of the requester's connect() --- */

static int accept_loopback_client(void)
{
    int listen_sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (listen_sock < 0) {
        perror("socket");
        return -1;
    }

    struct sockaddr_un addr = {0};
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, LOOPBACK_SOCK_PATH, sizeof(addr.sun_path) - 1);

    /* Stale socket file from a previous run/crash would otherwise make
     * bind() fail with "Address already in use". */
    unlink(LOOPBACK_SOCK_PATH);

    if (bind(listen_sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("bind");
        close(listen_sock);
        return -1;
    }

    if (listen(listen_sock, 1) < 0) {
        perror("listen");
        close(listen_sock);
        return -1;
    }

    printf("spdm-responder-app: listening on %s, waiting for requester...\n",
           LOOPBACK_SOCK_PATH);

    int client_sock = accept(listen_sock, NULL, NULL);
    if (client_sock < 0) {
        perror("accept");
        close(listen_sock);
        return -1;
    }

    /* Only ever expecting one client for this bring-up milestone - close
     * the listening socket once we have it. */
    close(listen_sock);
    printf("spdm-responder-app: requester connected.\n");
    return client_sock;
}

int main(void)
{
    g_sock = accept_loopback_client();
    if (g_sock < 0) {
        fprintf(stderr, "failed to accept a requester connection\n");
        return 1;
    }

    size_t context_size = libspdm_get_context_size();
    void *spdm_context = malloc(context_size);
    if (!spdm_context) {
