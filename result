admin@artesyn-shelf:~# cat watch.sh
watch -n 1 '
BUS=15

printf "%-4s %-4s %8s %8s %7s %7s %7s %7s\n" \
"ADC" "REG" "RAWHEX" "RAWDEC" "UNHEX" "UNDEC" "SWHEX" "SWDEC"

printf "%-4s %-4s %8s %8s %7s %7s %7s %7s\n" \
"----" "----" "--------" "--------" "-------" "-------" "-------" "-------"

for ADDR in 0x1d 0x35
do
    for REG in 0x21 0x22 0x23 0x24 0x25
    do
        RAW=$(i2cget -y $BUS $ADDR $REG w)
        RAW_DEC=$((RAW))

        LOW=$((RAW_DEC & 0xFF))
        HIGH=$((RAW_DEC >> 8))

        UNSWAP_12=$((RAW_DEC >> 4))

        SWAP=$(((LOW << 8) | HIGH))
        SWAP_12=$((SWAP >> 4))

        printf "%4s %4s %8s %8d %7s %7d %7s %7d\n" \
            "$ADDR" \
            "$REG" \
            "$(printf "0x%04X" $RAW_DEC)" \
            "$RAW_DEC" \
            "$(printf "0x%03X" $UNSWAP_12)" \
            "$UNSWAP_12" \
            "$(printf "0x%03X" $SWAP_12)" \
            "$SWAP_12"
    done
done
'

