Description=OSAL Network D-Bus service
After=dbus.service systemd-networkd.service
Requires=dbus.service

[Service]
Type=dbus
BusName=aei.osal.network1
ExecStart=/usr/bin/osal_network_service
Restart=on-failure

[Install]
