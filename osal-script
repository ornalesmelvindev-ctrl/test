[Unit]
Description=Generate networkd 80-wired.conf from nwk.cfg
DefaultDependencies=no

# Wait for storage and network directories to be mounted
RequiresMountsFor=/staging /etc/systemd/network

# Block the network from coming online until this script finishes
Before=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/osal_network_boot

[Install]
WantedBy=network.target


osal-network.serfice
[Unit]
Description=OSAL Network D-Bus service
After=dbus.service systemd-networkd.service
Requires=dbus.service

[Service]
Type=dbus
BusName=aei.osal.network1
ExecStart=/usr/bin/osal_network_service
Restart=on-failure

[Install]
WantedBy=multi-user.target


