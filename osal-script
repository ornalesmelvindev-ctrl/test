uint8_t calculateSubnetPrefixLength(char *subnet)
{
    uint8_t prefix = 0;
    uint8_t prefixLength = 0;
    char *lasts = NULL;
    char *token = strtok_r(subnet, ".", &lasts);

    while (token != NULL)
    {
        prefix = (uint8_t)atoi(token);

        for (uint8_t i = 0; i < 8; i++)
        {
            if (prefix & 0x01)
            {
                prefixLength++;
            }

            prefix >>= 1;
        }

        token = strtok_r(NULL, ".", &lasts);
    }

    return prefixLength;
}

