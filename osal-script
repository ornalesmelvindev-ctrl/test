CMakeLists.txt
cmake_minimum_required(VERSION 3.10)

project(osal_network VERSION 1.0.0 LANGUAGES C)

include(GNUInstallDirs)

find_package(PkgConfig REQUIRED)

pkg_check_modules(JSONC REQUIRED IMPORTED_TARGET json-c)
pkg_check_modules(SYSTEMD IMPORTED_TARGET libsystemd)

option(OSAL_BUILD_TESTS "Build unit tests" OFF)

set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS ON)

set(CMAKE_C_VISIBILITY_PRESET hidden)

add_compile_options(
    -Wall
    -Wextra
)

add_library(osal_network SHARED
    src/util.c
    src/validate.c
    src/store.c
    src/render.c
    src/config.c
    src/runtime.c
    src/sysbus.c
)

set_target_properties(osal_network PROPERTIES
    VERSION ${PROJECT_VERSION}
    SOVERSION 1
)

target_include_directories(osal_network
    PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
    PRIVATE
        src
)

target_link_libraries(osal_network
    PRIVATE
        PkgConfig::JSONC
)

if(SYSTEMD_FOUND)
    target_compile_definitions(osal_network
        PRIVATE
            OSAL_HAVE_SDBUS
    )

    target_link_libraries(osal_network
        PRIVATE
            PkgConfig::SYSTEMD
    )
else()
    message(WARNING "libsystemd not found: networkd reload / D-Bus events disabled")
endif()

add_executable(osal_cli
    cli/main.c
)

target_link_libraries(osal_cli
    PRIVATE
        osal_network
)

configure_file(
    osal_network.pc.in
    osal_network.pc
    @ONLY
)

install(
    TARGETS
        osal_network
        osal_cli
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
)

install(
    FILES
        include/osal_network.h
    DESTINATION
        ${CMAKE_INSTALL_INCLUDEDIR}
)

install(
    FILES
        ${CMAKE_CURRENT_BINARY_DIR}/osal_network.pc
    DESTINATION
        ${CMAKE_INSTALL_LIBDIR}/pkgconfig
)

install(
    FILES
        cli/osal_cli_completion
    DESTINATION
        ${CMAKE_INSTALL_SYSCONFDIR}/bash_completion.d
    RENAME
        osal_cli
)

if(OSAL_BUILD_TESTS)

    enable_testing()

    add_executable(
        test_validate
        tests/test_validate.c
    )

    target_link_libraries(
        test_validate
        PRIVATE
        osal_network
    )

    add_test(
        NAME validate
        COMMAND test_validate
    )

    add_test(
        NAME cli
        COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/tests/cli_test.sh
                $<TARGET_FILE:osal_cli>
    )

endif()

osal-network.bb
SUMMARY = "OSAL network library (libosal_network) and osal_cli"
LICENSE = "CLOSED"

SRC_URI = " \
    git://git@bitbucket.org/advenergy/network-osal.git;protocol=ssh;branch=develop \
"

PV = "1.0+git${SRCPV}"
SRCREV = "${AUTOREV}"

S = "${WORKDIR}/git"

DEPENDS = "json-c systemd"

inherit cmake pkgconfig systemd features_check

REQUIRED_DISTRO_FEATURES = "systemd"

SYSTEMD_SERVICE_${PN} = "osal-network-boot.service"
SYSTEMD_AUTO_ENABLE = "enable"

EXTRA_OECMAKE = " \
    -DOSAL_BUILD_TESTS=OFF \
"

do_install_append() {
    if ${@bb.utils.contains('DISTRO_FEATURES', 'systemd', 'true', 'false', d)}; then
        install -d ${D}${systemd_unitdir}/system

        for service in ${SYSTEMD_SERVICE_${PN}}; do
            install -m 0644 \
                ${S}/systemd/${service} \
                ${D}${systemd_unitdir}/system/
        done
    fi
}

