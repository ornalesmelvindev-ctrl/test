LICENSE = "CLOSED"
LIC_FILES_CHKSUM = ""

SRC_URI = " \
        git://git@bitbucket.org/advenergy/ewd-orv3-pmc-poll-manager.git;protocol=ssh;branch=develop\
    "

# Modify these as desired
PV = "1.0+git${SRCPV}"

# ${AUTOREV} can work if you want latest commit
SRCREV = "${AUTOREV}"


S = "${WORKDIR}/git"

OECMAKE_SOURCEPATH = "${S}/src"
SRC_CONFIG = "${S}/config"

DEPENDS = "systemd json-c sqlite3 osal-network"

inherit cmake systemd features_check

# As this package is tied to systemd, only build it when we're also building systemd.
REQUIRED_DISTRO_FEATURES = "systemd"

# This is enabled by default in class
# SYSTEMD_AUTO_ENABLE = "disable"
SYSTEMD_SERVICE_${PN} = "pmpmc.service"

DBUS_SERVICE_FILE = "aei.mc.pollmanager.service"
DBUS_CONF_FILE = "aei.mc.pollmanager1.conf"

FILES_${PN} += " \
			${datadir}/dbus-1/system-services \
			${datadir}/dbus-1/systemd.d \
			${datadir}/dbus-1/system-services/${DBUS_SERVICE_FILE} \
			${datadir}/dbus-1/system.d/${DBUS_CONF_FILE} \
		"

do_install_append() {
	if ${@bb.utils.contains('DISTRO_FEATURES', 'systemd', 'true', 'false', d)}; then
		install -d ${D}${systemd_unitdir}/system
		for service in ${SYSTEMD_SERVICE_${PN}}; do
			install -m 0644 ${SRC_CONFIG}/systemd-config/${service} ${D}${systemd_unitdir}/system/
			sed -i -e 's,@BINDIR@,${bindir},g' ${D}${systemd_unitdir}/system/${service}
		done
	fi

	# D-bus
	install -d ${D}${datadir}/dbus-1/system-services
	install -d ${D}${datadir}/dbus-1/system.d
	install -m 0644 ${SRC_CONFIG}/dbus-config/${DBUS_SERVICE_FILE} ${D}${datadir}/dbus-1/system-services/
	install -m 0644 ${SRC_CONFIG}/dbus-config/${DBUS_CONF_FILE} ${D}${datadir}/dbus-1/system.d/
	sed -i -e 's,@BINDIR@,${bindir},g' ${D}${datadir}/dbus-1/system-services/${DBUS_SERVICE_FILE}
	sed -i -e 's,@BINDIR@,${bindir},g' ${D}${datadir}/dbus-1/system.d/${DBUS_CONF_FILE}
}

# Specify any options you want to pass to cmake using EXTRA_OECMAKE:
EXTRA_OECMAKE = ""

